
* {
    box-sizing: border-box;
}

:root {
    --paper: #eeece5;
    --ink: #1b201c;
    --muted: #777b71;
    --gold: #c7a879;
    --dark: #171d19;
    --line: rgba(27, 32, 28, .17);
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "IBM Plex Sans Arabic", sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

/* Top Bar */

.topline {
    height: 32px;
    background: #202721;
    color: #d5d3ca;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 9px;
}

.pulse,
.eyebrow span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    display: inline-block;
}

.latin {
    font: 8px Manrope, sans-serif;
    letter-spacing: .16em;
    color: #aaa99f;
    margin-right: 18px;
}

/* Header */

.header {
    height: 82px;
    padding: 0 6.5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--paper);
    position: relative;
    z-index: 5;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand > span:last-child {
    display: flex;
    flex-direction: column;
}

.brand b {
    font-size: 25px;
    line-height: 1;
}

.brand small {
    font-size: 9px;
    color: var(--muted);
    margin-top: 5px;
}

.symbol {
    width: 34px;
    height: 34px;
    border: 1px solid #9b896a;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    padding: 6px;
}

.symbol i {
    display: block;
    width: 6px;
    background: #9b896a;
}

.symbol i:nth-child(1) { height: 12px; }
.symbol i:nth-child(2) { height: 19px; }
.symbol i:nth-child(3) { height: 24px; }

.nav {
    display: flex;
    gap: 38px;
    font-size: 12px;
    color: #5c6057;
}

.nav a:hover {
    color: #9b7950;
}

.header-link {
    border: 1px solid #a18d6d;
    padding: 12px 18px;
    font-size: 11px;
}

.header-link b {
    margin-right: 15px;
    color: #a7895d;
}

.menu-toggle {
    display: none;
}

/* Hero */

.hero {
    height: min(770px, calc(100vh - 114px));
    min-height: 620px;
    position: relative;
    color: white;
    overflow: hidden;
    background: #333;
}

.hero-photo,
.hero-overlay {
    position: absolute;
    inset: 0;
}

.hero-photo {
    background:
        url("https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2200&q=90")
        center 52% / cover;

    animation: zoom 1.5s ease-out both;
}

.hero-overlay {
    background:
        linear-gradient(
            90deg,
            rgba(8,13,10,.8),
            rgba(8,13,10,.45) 55%,
            rgba(8,13,10,.15)
        ),
        linear-gradient(
            0deg,
            rgba(8,10,9,.55),
            transparent 38%
        );
}

.hero-content {
    position: absolute;
    top: 15%;
    right: 11%;
    max-width: 660px;
    animation: rise .9s .15s both;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    color: #777b71;
}

.eyebrow.light {
    color: #d1d0c8;
}

.hero-kicker {
    margin: 48px 0 12px;
    font-size: 13px;
    color: #d4c4a9;
}

.hero h1 {
    font-size: clamp(58px, 7.8vw, 110px);
    line-height: 1.12;
    letter-spacing: -4px;
    margin: 0;
    font-weight: 500;
}

.hero h1 em,
.intro h2 em,
.section-head h2 em,
.contact h2 em {
    font-style: normal;
    color: var(--gold);
}

.hero-desc {
    max-width: 430px;
    color: #d2d2ca;
    font-size: 14px;
    line-height: 2;
    margin: 24px 0 30px;
}

.hero-actions {
    display: flex;
    align-items: center;
    gap: 30px;
}

.btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 16px 21px;
    background: var(--gold);
    color: #1c201b;
    font-size: 12px;
    transition: .25s;
}

.btn-gold:hover {
    background: #dfc69e;
    transform: translateY(-3px);
}

.plain-link {
    font-size: 11px;
    color: #f0eee7;
}

.plain-link span {
    margin-right: 12px;
}

.hero-vertical {
    position: absolute;
    left: 6.5%;
    top: 35%;
    display: flex;
    align-items: center;
    gap: 13px;
    writing-mode: vertical-rl;
    font: 9px Manrope;
    color: #ddd;
}

.hero-vertical i {
    height: 65px;
    width: 1px;
    background: #c4b18d;
}

.hero-foot {
    position: absolute;
    bottom: 25px;
    right: 6.5%;
    left: 6.5%;
    display: flex;
    justify-content: space-between;
    color: #c4c5bc;
    font: 8px Manrope;
}

.hero-foot span:nth-child(2) {
    font: 10px "IBM Plex Sans Arabic";
}

.hero-frame {
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(255,255,255,.13);
    pointer-events: none;
}

/* General Sections */

.section {
    padding: 105px 11%;
}

.section-label {
    font: 10px Manrope;
    color: #a08c6d;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
}

.section-label span {
    margin-left: 12px;
}

.section-label i {
    display: inline-block;
    height: 1px;
    width: 25px;
    background: #a08c6d;
    vertical-align: middle;
    margin-left: 10px;
}

/* About */

.intro-grid,
.section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8%;
    align-items: end;
}

.intro-grid {
    padding: 65px 0 55px;
}

.intro h2,
.section-head h2 {
    font-size: clamp(45px, 5.2vw, 70px);
    line-height: 1.2;
    letter-spacing: -2px;
    font-weight: 500;
    margin: 22px 0 0;
}

.intro-copy {
    max-width: 480px;
}

.lead {
    font-size: 20px;
    line-height: 1.8;
    margin: 0 0 15px;
}

.intro-copy > p:not(.lead),
.section-head > p {
    font-size: 13px;
    color: #72766d;
    line-height: 2.1;
}

.under-link {
    display: inline-flex;
    gap: 35px;
    border-bottom: 1px solid #9e8b6c;
    padding: 14px 0 8px;
    margin-top: 14px;
    font-size: 11px;
}

.under-link b {
    color: #a7895d;
}

.numbers {
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-top: 28px;
}

.numbers > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 1px solid var(--line);
    padding-right: 20px;
}

.numbers strong {
    font: 500 43px Manrope;
    letter-spacing: -2px;
}

.numbers strong span {
    color: #a7895d;
}

.numbers small,
.numbers-note span {
    font-size: 11px;
    color: #77796f;
}

.numbers .numbers-note {
    border: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.numbers-note b {
    font-size: 24px;
    color: #9e8b6c;
}

/* Services */

.services {
    background: #e5e3db;
}

.section-head {
    padding: 55px 0 45px;
}

.section-head h2 {
    margin-top: 20px;
}

.section-head > p {
    max-width: 390px;
    margin-bottom: 5px;
}

.service-list {
    border-top: 1px solid var(--line);
}

.service-list article {
    display: grid;
    grid-template-columns: 70px 1fr 45px;
    align-items: center;
    padding: 27px 10px;
    border-bottom: 1px solid var(--line);
    transition: .25s;
}

.service-list article:hover {
    padding-right: 22px;
    background: rgba(255,255,255,.35);
}

.service-no {
    font: 11px Manrope;
    color: #a08c6d;
}

.service-list h3 {
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 5px;
}

.service-list p {
    font-size: 11px;
    color: #77796f;
    margin: 0;
}

.service-list article > b {
    font-size: 22px;
    color: #9b8059;
    text-align: left;
}

/* Projects */

.projects {
    background: var(--dark);
    color: #f1f0e9;
}

.projects .section-label {
    border-color: rgba(255,255,255,.2);
    color: #b9a17d;
}

.projects .section-head h2 {
    color: #f1f0e9;
}

.projects .section-head > a {
    justify-self: start;
    margin-bottom: 12px;
}

.project-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-template-rows: 260px 260px;
    gap: 16px;
}

.project {
    position: relative;
    overflow: hidden;
    display: block;
    background: #303630;
}

.project-main {
    grid-row: span 2;
}

.project img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.72);
    transition: transform .7s;
}

.project:hover img {
    transform: scale(1.055);
}

.project-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        0deg,
        rgba(5,8,6,.78),
        transparent 60%
    );
}

.project > small {
    position: absolute;
    top: 20px;
    right: 22px;
    font: 9px Manrope;
}

.project > div {
    position: absolute;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.project > div b {
    font-size: 23px;
    font-weight: 500;
}

.project > div span {
    font-size: 10px;
    color: #d0d0c8;
}

.project > i {
    position: absolute;
    left: 24px;
    bottom: 28px;
    font-size: 21px;
    color: var(--gold);
    font-style: normal;
}

.disclaimer {
    font-size: 9px;
    color: #898d83;
    margin-top: 17px;
}

/* Method */

.steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 50px;
}

.steps article {
    border-top: 1px solid #a99778;
    padding-top: 20px;
}

.steps article > span {
    font: 11px Manrope;
    color: #a08c6d;
}

.steps h3 {
    font-size: 21px;
    font-weight: 500;
    margin: 26px 0 8px;
}

.steps p {
    font-size: 11px;
    color: #77796f;
    line-height: 1.9;
    margin: 0;
    max-width: 190px;
}

/* Contact */

.contact {
    background: #252c26;
    color: #f1f0e9;
    padding: 95px 11%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
}

.contact:after {
    content: "";
    position: absolute;
    width: 480px;
    height: 480px;
    border: 1px solid rgba(200,168,120,.16);
    border-radius: 50%;
    left: 12%;
    top: -55%;
    box-shadow:
        0 0 0 55px rgba(200,168,120,.025),
        0 0 0 110px rgba(200,168,120,.02);
}

.contact h2 {
    font-size: clamp(48px, 6vw, 80px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -3px;
    margin: 28px 0 12px;
}

.contact-copy > p {
    font-size: 12px;
    color: #b9bcb2;
    margin-bottom: 27px;
}

.seal {
    width: 155px;
    height: 155px;
    border: 1px solid rgba(200,168,120,.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    color: var(--gold);
    position: relative;
    z-index: 1;
}

.seal strong {
    font: 500 62px Manrope;
    line-height: 1;
}

.seal span {
    font: 8px Manrope;
    letter-spacing: .17em;
    text-align: center;
    margin-top: 8px;
}

/* Footer */

.footer {
    padding: 27px 6.5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #171b18;
    color: #aeb1a7;
    font-size: 10px;
}

.footer .brand b {
    color: #eee;
}

.footer .brand small {
    color: #999;
}

.footer > a:last-child {
    color: var(--gold);
}

/* Animations */

.reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .65s ease, transform .65s ease;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

@keyframes rise {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes zoom {
    from { transform: scale(1.09); }
    to { transform: scale(1.02); }
}

/* Responsive */

@media(max-width:800px) {
    .header {
        padding: 0 5%;
        height: 72px;
    }

    .nav {
        gap: 17px;
    }

    .nav a {
        font-size: 10px;
    }

    .hero {
        min-height: 620px;
    }

    .hero-content {
        right: 8%;
        left: 8%;
        top: 17%;
    }

    .hero h1 {
        font-size: clamp(55px, 11vw, 85px);
    }

    .section {
        padding: 75px 7%;
    }

    .intro-grid,
    .section-head {
        gap: 35px;
    }

    .project-grid {
        grid-template-rows: 220px 220px;
    }

    .contact {
        padding: 75px 7%;
    }
}

@media(max-width:600px) {

    .latin {
        display: none;
    }

    .header {
        height: 68px;
    }

    .menu-toggle {
        display: flex;
        flex-direction: column;
        gap: 6px;
        border: 0;
        background: none;
        padding: 10px;
        z-index: 7;
    }

    .menu-toggle span {
        width: 23px;
        height: 1px;
        background: #252820;
    }

    .nav {
        display: none;
        position: absolute;
        top: 68px;
        right: 0;
        left: 0;
        background: var(--paper);
        padding: 24px 7%;
        flex-direction: column;
        gap: 22px;
        border-top: 1px solid var(--line);
    }

    .nav.open {
        display: flex;
    }

    .header-link {
        margin-right: auto;
        margin-left: 12px;
    }

    .hero {
        min-height: 610px;
        height: calc(100svh - 100px);
    }

    .hero-photo {
        background-position: 58% center;
    }

    .hero-content {
        top: 15%;
        right: 7%;
        left: 7%;
    }

    .hero-kicker {
        margin-top: 48px;
    }

    .hero h1 {
        font-size: 58px;
        letter-spacing: -2px;
    }

    .hero-desc {
        font-size: 12px;
        max-width: 330px;
    }

    .hero-vertical {
        display: none;
    }

    .hero-foot {
        right: 7%;
        left: 7%;
        font-size: 7px;
    }

    .hero-foot span:last-child {
        display: none;
    }

    .hero-actions {
        gap: 18px;
    }

    .btn-gold {
        padding: 14px 15px;
        gap: 15px;
        font-size: 10px;
    }

    .section {
        padding: 66px 7%;
    }

    .intro-grid,
    .section-head {
        grid-template-columns: 1fr;
        gap: 20px;
        padding: 42px 0;
    }

    .intro h2,
    .section-head h2 {
        font-size: 48px;
    }

    .lead {
        font-size: 17px;
    }

    .numbers {
        grid-template-columns: 1fr 1fr;
        row-gap: 25px;
    }

    .numbers > div {
        padding-right: 12px;
    }

    .numbers > div:nth-child(2) {
        border: 0;
    }

    .numbers strong {
        font-size: 35px;
    }

    .numbers .numbers-note {
        border: 0;
    }

    .service-list article {
        grid-template-columns: 35px 1fr 25px;
        padding: 23px 2px;
    }

    .service-list h3 {
        font-size: 17px;
    }

    .service-list p {
        font-size: 10px;
        line-height: 1.8;
    }

    .project-grid {
        grid-template-columns: 1fr;
        grid-template-rows: 310px 230px 230px;
    }

    .project-main {
        grid-row: auto;
    }

    .steps {
        grid-template-columns: 1fr 1fr;
        row-gap: 32px;
    }

    .steps h3 {
        margin-top: 17px;
    }

    .contact {
        padding: 70px 7%;
    }

    .contact h2 {
        font-size: 55px;
    }

    .seal {
        width: 95px;
        height: 95px;
        position: absolute;
        left: 7%;
        top: 75px;
        opacity: .7;
    }

    .seal strong {
        font-size: 38px;
    }

    .seal span {
        font-size: 6px;
    }

    .footer {
        padding: 24px 6%;
        gap: 15px;
        flex-wrap: wrap;
    }

    .footer > span {
        order: 3;
        width: 100%;
        text-align: center;
    }

    .footer .brand b {
        font-size: 20px;
    }
}
